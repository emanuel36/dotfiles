theme = github-dark
maximize = true
cursor-style = underline
desktop-notifications = true
clipboard-write = allow
copy-on-select = true
cursor-style-blink = true
shell-integration-features = no-cursor
clipboard-paste-protection = false
scrollbar = never
mouse-scroll-multiplier = precision:3

# --- Splits: navegação ---
keybind = ctrl+alt+arrow_up=unbind
keybind = ctrl+alt+arrow_down=unbind
keybind = ctrl+alt+arrow_left=unbind
keybind = ctrl+alt+arrow_right=unbind
keybind = alt+up=goto_split:up
keybind = alt+down=goto_split:down
keybind = alt+left=goto_split:left
keybind = alt+right=goto_split:right

# --- Splits: criação ---
keybind = ctrl+shift+o=unbind
keybind = ctrl+shift+e=unbind
keybind = alt+shift+up=new_split:up
keybind = alt+shift+down=new_split:down
keybind = alt+shift+left=new_split:left
keybind = alt+shift+right=new_split:right

# --- Splits: redimensionar ---
keybind = super+ctrl+shift+arrow_up=unbind
keybind = super+ctrl+shift+arrow_down=unbind
keybind = super+ctrl+shift+arrow_left=unbind
keybind = super+ctrl+shift+arrow_right=unbind
keybind = ctrl+shift+arrow_left=unbind
keybind = ctrl+shift+arrow_right=unbind
keybind = ctrl+shift+up=resize_split:up,10
keybind = ctrl+shift+down=resize_split:down,10
keybind = ctrl+shift+left=resize_split:left,10
keybind = ctrl+shift+right=resize_split:right,10

# --- Splits: zoom / igualar / fechar ---
keybind = alt+z=toggle_split_zoom
keybind = alt+equal=equalize_splits
keybind = alt+q=close_surface
confirm-close-surface = false
