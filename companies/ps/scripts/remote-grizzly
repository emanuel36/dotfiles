#!/bin/bash

# SSH connection to Grizzly devices via tunnel ports

function usage()
{
	echo "Usage: remote-grizzly port1 [port2 port3 ...]"
	echo "    port: SSH tunnel port on the Grizzly device"
	echo "    Multiple ports can be provided to execute commands on multiple devices"
	echo
	exit 1
}

if [ -z "$1" ]; then
	usage
fi

IP="172.23.14.29"
USER=epereir
JUMP_BOX="jumpbox.fleethealth.io"
PORTS=("$@")

PCG_KEY="${HOME}/.ssh/id_rsa.pcg"
OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o HostKeyAlgorithms=+ssh-rsa -o PubkeyAcceptedKeyTypes=+ssh-rsa" 
ENV_KEY="${HOME}/.ssh/id_rsa"

# Helper function to run SSH with warning filtering
function run_ssh() {
  local port=$1
  shift
  
  local temp_err=$(mktemp)
  local temp_out=$(mktemp)
  
  # Execute SSH command with timeout and capture output/errors
  timeout 30s ssh $OPTS -o ProxyCommand="ssh -W %h:%p $OPTS -i $ENV_KEY ${USER}@$IP" -p $port -i $PCG_KEY root@localhost "$@" > "$temp_out" 2> "$temp_err"
  local ret=$?
  
  # Display filtered output
  [ -s "$temp_out" ] && cat "$temp_out"
  
  if [ $ret -ne 0 ]; then
    if [ $ret -eq 124 ]; then
      echo "Connection timed out after 30 seconds. Skipping to next port."
    elif grep -q "Connection refused" "$temp_err"; then
      echo "Connection refused"
    else
      grep -v -E "(Warning: Permanently added|Pseudo-terminal will not be allocated|stdin: is not a tty)" "$temp_err" >&2
    fi
  fi
  
  # Clean up temp files
  rm -f "$temp_err" "$temp_out"
  return $ret
}

# Helper function to run SCP
function run_scp() {
  local port=$1
  local src=$2
  local dest=$3
  
  scp -O $OPTS -o ProxyCommand="ssh -W %h:%p $OPTS -i $ENV_KEY ${USER}@$IP" -P $port -i $PCG_KEY \
    $src $dest
  return $?
}

# Connect to remote shell via SSH
function connect_shell() {
  local port=$1
  echo "Connecting to Grizzly at $port..."
  ssh $OPTS -t -o ProxyCommand="ssh -W %h:%p $OPTS -i $ENV_KEY ${USER}@$IP" -p $port -i $PCG_KEY root@localhost
  local ret=$?
  
  # Check if connection failed
  if [ $ret -ne 0 ]; then
    echo "Connection failed with code $ret"
  fi
  return $ret
}

# Get all .cantrace files from /opt/data
function get_files() {
  local port=$1
  local REMOTE_DIR="/opt/data"
  local PATTERN="*.cantrace"
  
  echo "Getting cantrace files from port $port..."
  run_scp "$port" "root@localhost:${REMOTE_DIR}/${PATTERN}" "$(pwd)/"
    
  echo "Cleaning remote files and stopping tmux session..."
  run_ssh "$port" << 'EOF'
    tmux kill-server 2>/dev/null
    rm -f /opt/data/*.cantrace 2>/dev/null
    echo "Cleanup completed."
EOF
}

# Start CAN capture in tmux session
function capture_can() {
  local port=$1
  local TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
  local FILENAME="${TIMESTAMP}.cantrace"
  
  echo "Starting CAN capture at port $port..."
  
  run_ssh "$port" << EOF
    tmux kill-server 2>/dev/null
    tmux new-session -d -s cantrace "ip netns exec vehicle-bus candump -L can0 > /opt/data/${FILENAME}"
    tmux ls 2>/dev/null
    sleep 1
    ls -lh /opt/data/*.cantrace 2>/dev/null | awk '{print \$5, \$6, \$7, \$8, \$9}'
EOF
}

# Check CAN capture status
function check_status() {
  local port=$1
  echo "Checking CAN capture status at port $port..."
  run_ssh "$port" << 'EOF'
    echo "Active tmux sessions:"
    tmux ls 2>/dev/null || echo "No active tmux sessions"
    echo "
Cantrace files:"
    ls -lh /opt/data/*.cantrace 2>/dev/null | awk '{print $5, $6, $7, $8, $9}' || echo "No cantrace files found"
EOF
}

# Stop capture and clean files
function stop_capture() {
  local port=$1
  echo "Stopping CAN capture and cleaning files on device at port $port..."
  run_ssh "$port" << 'EOF'
    echo "Stopping tmux sessions:"
    tmux kill-server 2>/dev/null && echo "Tmux sessions terminated" || echo "No active tmux sessions"
    
    echo "Removing cantrace files:"
    COUNT=$(ls -1 /opt/data/*.cantrace 2>/dev/null | wc -l)
    if [ $COUNT -gt 0 ]; then
      rm -f /opt/data/*.cantrace 2>/dev/null
      echo "$COUNT file(s) removed"
    else
      echo "No cantrace files found"
    fi
EOF
}

# Menu
echo "Selected ports: ${PORTS[*]}"
echo "Select an option:"
echo "  1) Connect to shell"
echo "  2) Start CAN capture"
echo "  3) Get cantrace files"
echo "  4) Check capture status"
echo "  5) Stop capture and clean files"
echo "  q) Exit"
echo
read -rp "Option: " choice

case "$choice" in
  1)
    for port in "${PORTS[@]}"; do
      connect_shell "$port"
      echo "-----------------------------------"
    done
    ;;
  2)
    for port in "${PORTS[@]}"; do
      capture_can "$port"
      echo "-----------------------------------"
    done
    ;;
  3)
    for port in "${PORTS[@]}"; do
      get_files "$port"
      echo "-----------------------------------"
    done
    ;;
  4)
    for port in "${PORTS[@]}"; do
      check_status "$port"
      echo "-----------------------------------"
    done
    ;;
  5)
    for port in "${PORTS[@]}"; do
      stop_capture "$port"
      echo "-----------------------------------"
    done
    ;;
  q|Q)
    echo "Exiting."
    ;;
  *)
    echo "Invalid option."
    exit 1
    ;;
esac
