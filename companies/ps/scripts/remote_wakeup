#!/usr/bin/env python3

import argparse
import os

import requests

from config import config
from logger import CustomLogger

# Logger setup
logger = CustomLogger(os.path.basename(__file__))


BASE_URL = "http://ft-api.prod.trimblevi.com:20500/openapi"


class RemoteWakeup:
    def __init__(self, device_id):
        self.device_id = device_id
        self.token = None
        self.base_url = BASE_URL
        self.auth_url = f"{self.base_url}/auth"
        self.data_url = f"{self.base_url}/v2/devices/{self.device_id}"

    def authenticate(self):
        auth_payload = {
            "effectiveTime": 0,
            "identifyCode": "streamax",
            "secret": config["credentials"]["secret"],
        }
        response = requests.post(self.auth_url, json=auth_payload, timeout=10)
        response.raise_for_status()
        self.token = response.json().get('data', {}).get('token')
        if not self.token:
            raise ValueError("Authentication failed, no token received\n")

    def device_wakeup(self):
        headers = {
            'Content-Type': 'application/json',
            'token': self.token
        }
        response = requests.post(f"{self.data_url}/wakeup/", headers=headers)
        return response.json()

    def device_dormant_state(self):
        headers = {
            'Content-Type': 'application/json',
            'token': self.token
        }
        response = requests.get(self.data_url, headers=headers)
        response.raise_for_status()
        return response.json()


def main():
    parser = argparse.ArgumentParser(description="Remote Wakeup CLI")
    parser.add_argument("device_id", help="ID of the device")
    parser.add_argument("--status", action="store_true", help="Get the status of the device")
    parser.add_argument("--wakeup", action="store_true", help="Wakeup the device")

    args = parser.parse_args()

    remote_wakeup = RemoteWakeup(args.device_id)
    remote_wakeup.authenticate()

    if args.status:
        response = remote_wakeup.device_dormant_state()
        logger.info(f"Device Status:{response}")
    if args.wakeup:
        response = remote_wakeup.device_wakeup()
        logger.info(f"Device Wakeup: {response}")

if __name__ == "__main__":
    main()

