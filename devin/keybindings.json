[
    {
        "key": "ctrl+k",
        "command": "workbench.files.action.collapseExplorerFolders",
        "when": "explorerViewletVisible"
    },
    {
        "key": "ctrl+shift+i",
        "command": "editor.action.formatSelection",
        "when": "editorHasSelection && editorTextFocus && !editorReadonly"
    }
]