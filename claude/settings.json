{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Bash",
      "mcp__claude-in-chrome",
      "mcp__plugin_atlassian_atlassian__discover",
      "mcp__plugin_atlassian_atlassian__executeRead",
      "mcp__plugin_atlassian_atlassian__search",
      "mcp__plugin_atlassian_atlassian__searchConfluence",
      "mcp__plugin_atlassian_atlassian__searchJiraIssuesUsingJql",
      "mcp__plugin_atlassian_atlassian__getConfluenceContent",
      "mcp__plugin_atlassian_atlassian__getJiraIssue",
      "mcp__plugin_atlassian_atlassian__getAccessibleAtlassianResources",
      "mcp__plugin_atlassian_atlassian__atlassianUserInfo",
      "mcp__plugin_atlassian_atlassian__getGraphContext",
      "mcp__plugin_atlassian_atlassian__getGraphObject",
      "mcp__claude_ai_Atlassian_Rovo__atlassianUserInfo",
      "mcp__claude_ai_Atlassian_Rovo__getAccessibleAtlassianResources",
      "mcp__claude_ai_Atlassian_Rovo__fetch",
      "mcp__claude_ai_Atlassian_Rovo__search",
      "mcp__claude_ai_Atlassian_Rovo__searchConfluenceUsingCql",
      "mcp__claude_ai_Atlassian_Rovo__searchJiraIssuesUsingJql",
      "mcp__claude_ai_Atlassian_Rovo__getConfluencePage",
      "mcp__claude_ai_Atlassian_Rovo__getConfluencePageDescendants",
      "mcp__claude_ai_Atlassian_Rovo__getConfluencePageFooterComments",
      "mcp__claude_ai_Atlassian_Rovo__getConfluencePageInlineComments",
      "mcp__claude_ai_Atlassian_Rovo__getConfluenceCommentChildren",
      "mcp__claude_ai_Atlassian_Rovo__getConfluenceSpaces",
      "mcp__claude_ai_Atlassian_Rovo__getPagesInConfluenceSpace",
      "mcp__claude_ai_Atlassian_Rovo__getContentFormatGuide",
      "mcp__claude_ai_Atlassian_Rovo__getJiraIssue",
      "mcp__claude_ai_Atlassian_Rovo__getJiraIssueRemoteIssueLinks",
      "mcp__claude_ai_Atlassian_Rovo__getJiraIssueTypeMetaWithFields",
      "mcp__claude_ai_Atlassian_Rovo__getJiraProjectIssueTypesMetadata",
      "mcp__claude_ai_Atlassian_Rovo__getTransitionsForJiraIssue",
      "mcp__claude_ai_Atlassian_Rovo__getVisibleJiraProjects",
      "mcp__claude_ai_Atlassian_Rovo__getIssueLinkTypes",
      "mcp__claude_ai_Atlassian_Rovo__lookupJiraAccountId",
      "mcp__claude_ai_Atlassian_Rovo__getCompassComponent",
      "mcp__claude_ai_Atlassian_Rovo__getCompassComponents",
      "mcp__claude_ai_Atlassian_Rovo__getCompassCustomFieldDefinitions",
      "mcp__claude_ai_Atlassian_Rovo__getTeamworkGraphContext",
      "mcp__claude_ai_Atlassian_Rovo__getTeamworkGraphObject",
      "mcp__plugin_slack_slack__slack_read_channel",
      "mcp__plugin_slack_slack__slack_read_thread",
      "mcp__plugin_slack_slack__slack_read_canvas",
      "mcp__plugin_slack_slack__slack_read_file",
      "mcp__plugin_slack_slack__slack_read_user_profile",
      "mcp__plugin_slack_slack__slack_list_channel_members",
      "mcp__plugin_slack_slack__slack_list_user_channels",
      "mcp__plugin_slack_slack__slack_get_reactions",
      "mcp__plugin_slack_slack__slack_search_channels",
      "mcp__plugin_slack_slack__slack_search_emojis",
      "mcp__plugin_slack_slack__slack_search_public",
      "mcp__plugin_slack_slack__slack_search_public_and_private",
      "mcp__plugin_slack_slack__slack_search_users"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "-c",
              "/usr/bin/gjs -m \"$0\" 2>/dev/null; exit 0",
              "/home/epereir/.local/share/gnome-shell/extensions/away-mode@emanuel36/hook.js"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/skills/daily-recap/scripts/catch_up.sh\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "-c",
              "/usr/bin/gjs -m \"$0\" 2>/dev/null; exit 0",
              "/home/epereir/.local/share/gnome-shell/extensions/away-mode@emanuel36/hook.js"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.dotfiles/claude/hooks/check_commit_msg.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "-c",
              "/usr/bin/gjs -m \"$0\" 2>/dev/null; exit 0",
              "/home/epereir/.local/share/gnome-shell/extensions/away-mode@emanuel36/hook.js"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "-c",
              "/usr/bin/gjs -m \"$0\" 2>/dev/null; exit 0",
              "/home/epereir/.local/share/gnome-shell/extensions/away-mode@emanuel36/hook.js"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "-c",
              "/usr/bin/gjs -m \"$0\" 2>/dev/null; exit 0",
              "/home/epereir/.local/share/gnome-shell/extensions/away-mode@emanuel36/hook.js"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "-c",
              "/usr/bin/gjs -m \"$0\" 2>/dev/null; exit 0",
              "/home/epereir/.local/share/gnome-shell/extensions/away-mode@emanuel36/hook.js"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "-c",
              "/usr/bin/gjs -m \"$0\" 2>/dev/null; exit 0",
              "/home/epereir/.local/share/gnome-shell/extensions/away-mode@emanuel36/hook.js"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "-c",
              "/usr/bin/gjs -m \"$0\" 2>/dev/null; exit 0",
              "/home/epereir/.local/share/gnome-shell/extensions/away-mode@emanuel36/hook.js"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "-c",
              "/usr/bin/gjs -m \"$0\" 2>/dev/null; exit 0",
              "/home/epereir/.local/share/gnome-shell/extensions/away-mode@emanuel36/hook.js"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "-c",
              "/usr/bin/gjs -m \"$0\" 2>/dev/null; exit 0",
              "/home/epereir/.local/share/gnome-shell/extensions/away-mode@emanuel36/hook.js"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "atlassian@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "cctabs@generativereality": true,
    "diagram-design@diagram-design": true,
    "humanizer@humanizer": true
  },
  "extraKnownMarketplaces": {
    "generativereality": {
      "source": {
        "source": "github",
        "repo": "generativereality/plugins"
      }
    },
    "diagram-design": {
      "source": {
        "source": "github",
        "repo": "cathrynlavery/diagram-design"
      }
    },
    "humanizer": {
      "source": {
        "source": "github",
        "repo": "blader/humanizer"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "low"
    }
  },
  "autoUpdatesChannel": "stable",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "verbose": true,
  "preferredNotifChannel": "ghostty",
  "teammateMode": "auto"
}
